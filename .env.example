# Telegram Bot API — from @BotFather, never commit the real token
TELEGRAM_BOT_TOKEN=

# Fernet key for music tokens in SQLite. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional. Default: .data/bot-users.sqlite
# BOT_DB_PATH=

# Yandex Music OAuth — used by yandex-spike
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Spotify Web API — used by yandex-spike spotify-spike
# Dashboard redirect URI must be exactly: http://127.0.0.1:8766/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
